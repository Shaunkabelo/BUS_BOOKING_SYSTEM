@model RegisterInput
@{ ViewData["Title"] = "Create account"; }
<section class="panel auth-panel"><span class="eyebrow">YOUR JOURNEY STARTS HERE</span><h1>Create your account</h1><p>Keep your trips and tickets together.</p>
<form asp-action="Register" method="post"><div asp-validation-summary="All" class="validation"></div>
<label asp-for="Name">Full name</label><input asp-for="Name" class="form-control" autocomplete="name" />
<label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="email" />
<label asp-for="Phone">Phone number</label><input asp-for="Phone" class="form-control" autocomplete="tel" />
<label asp-for="Password">Password (at least 10 characters)</label><input asp-for="Password" class="form-control" autocomplete="new-password" />
<label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
<button class="button full" type="submit">Create account</button></form><p class="mt-3">Already registered? <a asp-action="Login">Sign in</a></p></section>
