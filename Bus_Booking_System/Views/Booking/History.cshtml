@model List<Reservation>
@{ ViewData["Title"] = "My bookings"; }
<div class="section-heading"><div><span class="eyebrow">ALL YOUR JOURNEYS</span><h1>My bookings</h1></div><a class="button" asp-controller="Home" asp-action="Index">Book another trip</a></div>
@if (!Model.Any()) { <section class="panel empty"><h2>Your next adventure is waiting.</h2><p>Your bookings and printable tickets will appear here.</p></section> }
@foreach (var booking in Model)
{
<article class="panel booking-card"><div><span class="pill">@(booking.Status == "Cancelled" ? "Cancelled" : "Demo confirmed")</span><h2>@booking.Origin → @booking.Destination</h2><p>@booking.Departure.ToString("ddd, dd MMM yyyy · HH:mm")</p><small class="muted">Reference: @booking.Reference</small></div><div class="booking-actions"><strong>@TravelTime.Money(booking.Total)</strong><a class="button secondary" asp-action="Ticket" asp-route-reference="@booking.Reference">View ticket</a>
@if (booking.Status == "DemoConfirmed" && booking.Departure > TravelTime.Now) { <form asp-action="Cancel" method="post" onsubmit="return confirm('Cancel this booking and release the seats?')"><input type="hidden" name="reference" value="@booking.Reference" /><button class="text-button danger" type="submit">Cancel booking</button></form> }
</div></article>
}
