@model Reservation
@{ ViewData["Title"] = "Your ticket"; var trip = Model.Trip!; }
<div class="section-heading no-print"><h1>Your journey details</h1><button class="button" onclick="window.print()">Print / Save as PDF</button></div>
<article class="panel ticket"><div class="section-heading"><span class="brand">MzansiBus</span><span class="pill">@(Model.Status == "Cancelled" ? "CANCELLED" : "DEMO CONFIRMED")</span></div><h2>@trip.Origin → @trip.Destination</h2><p class="notice">DEMO TICKET — Not valid for travel. No payment was collected.</p><p><b>Booking reference</b><br /><span class="reference">@Model.Reference</span></p><div class="ticket-details"><div><b>Departure</b><p>@trip.Departure.ToString("dd MMM yyyy · HH:mm") SAST<br />@trip.BoardingPoint</p></div><div><b>Arrival</b><p>@trip.Arrival.ToString("dd MMM yyyy · HH:mm") SAST<br />@trip.ArrivalPoint</p></div><div><b>Operator</b><p>@trip.Company<br />@trip.BusType</p></div><div><b>Booked by</b><p>@Model.CustomerName<br />@Model.Email</p></div></div>
<table class="table"><thead><tr><th>Passenger</th><th>Seat</th></tr></thead><tbody>@foreach (var seat in Model.Seats) { <tr><td>@seat.PassengerName</td><td>@seat.SeatNumber</td></tr> }</tbody></table><div class="price-line"><span>Demo booking total</span><strong>@TravelTime.Money(Model.Total)</strong></div></article>
<a class="no-print" asp-action="History">← Back to my bookings</a>
