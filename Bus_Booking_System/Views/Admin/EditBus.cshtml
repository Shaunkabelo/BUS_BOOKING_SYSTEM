@model Bus_Booking_Library.Models.Domain.Bus
@{
    ViewData["Title"] = "Edit Bus";
}

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<h2>Edit Bus</h2>

<form method="post" asp-action="EditBus">
    <input type="hidden" asp-for="BusID" />

    <div class="mb-3">
        <label>Bus Number</label>
        <input asp-for="BusNumber" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Bus Type</label>
        <input asp-for="BusType" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Total Seats</label>
        <input asp-for="TotalSeats" class="form-control" type="number" required />
    </div>
    <div class="mb-3">
        <label>Available Seats</label>
        <input asp-for="AvailableSeats" class="form-control" type="number" required />
    </div>
    <button type="submit" class="btn btn-primary">Update Bus</button>
</form>

