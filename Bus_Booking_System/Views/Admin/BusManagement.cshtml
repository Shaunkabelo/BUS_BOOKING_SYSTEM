@model List<FleetInput>
@{ ViewData["Title"] = "Manage buses"; }
<partial name="_AdminNav" /><div class="section-heading"><h1>Your fleet</h1><a class="button" asp-action="AddBus">Add a bus</a></div><section class="panel table-responsive"><table class="table"><thead><tr><th>Bus number</th><th>Operator</th><th>Type</th><th>Seats</th><th>Actions</th></tr></thead><tbody>
@foreach (var b in Model) { <tr><td>@b.BusNumber</td><td>@b.Company</td><td>@b.BusType</td><td>@b.TotalSeats</td><td class="table-actions"><a asp-action="EditBus" asp-route-id="@b.Id">Edit</a><form asp-action="DeleteBus" method="post" onsubmit="return confirm('Delete this bus? Buses with schedules are protected.')"><input type="hidden" name="id" value="@b.Id" /><button class="text-button danger" type="submit">Delete</button></form></td></tr> }
</tbody></table></section>
