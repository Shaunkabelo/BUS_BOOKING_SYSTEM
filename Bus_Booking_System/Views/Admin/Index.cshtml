@model List<Reservation>
@{ ViewData["Title"] = "Administration"; }
<partial name="_AdminNav" /><span class="eyebrow">ADMINISTRATION</span><h1>A view of every journey.</h1>
<div class="stats"><section class="panel"><span>Total bookings</span><strong>@Model.Count</strong></section><section class="panel"><span>Demo confirmed</span><strong>@Model.Count(r => r.Status == "DemoConfirmed")</strong></section><section class="panel"><span>Confirmed demo value (not revenue)</span><strong>@TravelTime.Money(Model.Where(r => r.Status == "DemoConfirmed").Sum(r => r.Total))</strong></section></div>
<section class="panel"><h2>All bookings</h2><div class="table-responsive"><table class="table"><thead><tr><th>Customer</th><th>Journey</th><th>Departure</th><th>Total</th><th>Status</th></tr></thead><tbody>@foreach (var r in Model) { <tr><td>@r.CustomerName<br /><small>@r.Email</small></td><td>@r.Origin → @r.Destination</td><td>@r.Departure.ToString("dd MMM yyyy HH:mm")</td><td>@TravelTime.Money(r.Total)</td><td>@(r.Status == "Cancelled" ? "Cancelled" : "Demo confirmed")</td></tr> }</tbody></table></div>@if (!Model.Any()) { <p class="muted">No bookings yet.</p> }</section>
