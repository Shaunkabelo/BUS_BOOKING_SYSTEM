@model ScheduleInput
@{ ViewData["Title"] = "Add departure"; }
<partial name="_AdminNav" /><section class="panel narrow"><h1>Add a departure</h1><p>Enter departure and arrival in South African time (UTC+2).</p><form asp-action="AddSchedule" method="post"><div asp-validation-summary="All" class="validation"></div>
<label asp-for="BusId">Bus</label><select asp-for="BusId" class="form-select"><option value="0">Choose a bus</option>@foreach (var b in Model.Buses) { <option value="@b.Id">@b.BusNumber · @b.Company</option> }</select>
<label asp-for="Origin">Departure city</label><input asp-for="Origin" class="form-control" />
<label asp-for="Destination">Destination city</label><input asp-for="Destination" class="form-control" />
<label asp-for="BoardingPoint">Boarding point</label><input asp-for="BoardingPoint" class="form-control" />
<label asp-for="ArrivalPoint">Arrival point</label><input asp-for="ArrivalPoint" class="form-control" />
<label asp-for="Departure"></label><input asp-for="Departure" type="datetime-local" class="form-control" />
<label asp-for="Arrival"></label><input asp-for="Arrival" type="datetime-local" class="form-control" />
<label asp-for="Fare">Fare per passenger (ZAR)</label><input asp-for="Fare" type="number" step="0.01" min="1" max="10000" class="form-control" />
<button type="submit" class="button mt-3">Add departure</button> <a asp-action="Schedules">Cancel</a></form></section>
