@model Tuple<IEnumerable<Bus_Booking_Library.Models.Domain.Bus>, Bus_Booking_Library.Models.Domain.Bus>

@{
    ViewData["Title"] = "Add Bus";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var busList = Model.Item1;
    var newBus = Model.Item2;
}

<link href="~/css/admin.css" rel="stylesheet" />

<style>
    /* Overlay background */
    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;
    }

    /* Modal panel */
    .modal-container {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: white;
        padding: 20px;
        width: 40%;
        border-radius: 10px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
        display: none;
        z-index: 1001;
    }

    /* Close button */
    .close-btn {
        position: absolute;
        top: 10px;
        right: 15px;
        font-size: 20px;
        cursor: pointer;
    }

    /* Form styles */
    .modal-container input {
        width: 100%;
        padding: 8px;
        margin-top: 5px;
        border: 1px solid #ccc;
        border-radius: 5px;
    }

    .modal-buttons {
        display: flex;
        justify-content: space-between;
        margin-top: 15px;
    }

    .btn {
        padding: 8px 12px;
        cursor: pointer;
        border: none;
        border-radius: 5px;
    }

    .btn-success {
        background-color: green;
        color: white;
    }

    .btn-danger {
        background-color: red;
        color: white;
    }

    .btn-secondary {
        background-color: gray;
        color: white;
    }






    /* Modal Background */
    .modal {
        display: none;
        position: fixed;
        z-index: 1;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.4);
    }

    /* Modal Content */
    .modal-content {
        background-color: white;
        margin: 10% auto;
        padding: 20px;
        border: 1px solid #888;
        width: 50%;
        border-radius: 8px;
    }

    /* Close Button */
    .close {
        float: right;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
    }

    /* Modal Buttons */
    .modal-buttons {
        margin-top: 20px;
        text-align: right;
    }

</style>

<h2>Bus List</h2>

<table class="table mt-3">
    <thead>
        <tr>
            <th>Bus ID</th>
            <th>Bus Number</th>
            <th>Type</th>
            <th>Total Seats</th>
            <th>Available Seats</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (busList != null && busList.Any())
        {
            @foreach (var bus in busList)
            {
                <tr>
                    <td>@bus.BusID</td>
                    <td>@bus.BusNumber</td>
                    <td>@bus.BusType</td>
                    <td>@bus.TotalSeats</td>
                    <td>@bus.AvailableSeats</td>
                    <td>
                        <button class="btn btn-success" onclick="fetchBusDetails(@bus.BusID)">Edit</button>
                        <a href="@Url.Action("DeleteBus", "Admin", new { id = bus.BusID })" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this bus?');">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">No buses available.</td>
            </tr>
        }
    </tbody>
</table>

<!-- Button to Open Modal -->
<button class="btn btn-primary mt-3" onclick="openModal()">Add New Bus</button>

<!-- Modal Overlay -->
<div class="modal-overlay" id="modalOverlay" onclick="closeModal()"></div>

<!-- Modal Panel -->
<div class="modal-container" id="modalContainer">
    <span class="close-btn" onclick="closeModal()">&times;</span>
    <h3>Add New Bus</h3>

    <form method="post" asp-action="AddBus" onsubmit="return submitForm();">
        <div>
            <label>Bus Number</label>
            <input asp-for="@newBus.BusNumber" required />
        </div>
        <div>
            <label>Bus Type</label>
            <input asp-for="@newBus.BusType" required />
        </div>
        <div>
            <label>Company</label>
            <input asp-for="@newBus.Company" required />
        </div>
        <div>
            <label>Total Seats</label>
            <input asp-for="@newBus.TotalSeats" type="number" required />
        </div>
        <div>
            <label>Available Seats</label>
            <input asp-for="@newBus.AvailableSeats" type="number" required />
        </div>

        <div class="modal-buttons">
            <button type="submit" class="btn btn-success">Add Bus</button>
            <button type="button" class="btn btn-secondary" onclick="closeModal()">Cancel</button>
        </div>
    </form>
</div>




<!-- Edit Bus Modal -->
<div id="editBusModal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeEditModal()">&times;</span>
        <h2>Edit Bus</h2>

        <form id="editBusForm" method="post" onsubmit="return submitEditForm();">
            <input type="hidden" id="editBusId" name="busId" />

            <div>
                <label>Bus Number</label>
                <input id="editBusNumber" name="busNumber" required />
            </div>
            <div>
                <label>Bus Type</label>
                <input id="editBusType" name="busType" required />
            </div>
            <div>
                <label>Total Seats</label>
                <input id="editTotalSeats" name="totalSeats" type="number" required />
            </div>
            <div>
                <label>Available Seats</label>
                <input id="editAvailableSeats" name="availableSeats" type="number" required />
            </div>

            <div class="modal-buttons">
                <button type="submit" class="btn btn-success">Update Bus</button>
                <button type="button" class="btn btn-secondary" onclick="closeEditModal()">Cancel</button>
            </div>
        </form>
    </div>
</div>



<script>
    function openModal() {
        document.getElementById("modalOverlay").style.display = "block";
        document.getElementById("modalContainer").style.display = "block";
    }

    function closeModal() {
        document.getElementById("modalOverlay").style.display = "none";
        document.getElementById("modalContainer").style.display = "none";
    }

    function submitForm() {
        closeModal();
        return true;
    }


    async function fetchBusDetails(busId) {
        try {
            let response = await fetch(`/Admin/GetBusDetails?id=${busId}`);
            if (!response.ok) {
                throw new Error("Failed to fetch data");
            }

            let bus = await response.json();

            // Populate the edit form with bus details
            document.getElementById("editBusId").value = bus.busID;
            document.getElementById("editBusNumber").value = bus.busNumber;
            document.getElementById("editBusType").value = bus.busType;
            document.getElementById("editTotalSeats").value = bus.totalSeats;
            document.getElementById("editAvailableSeats").value = bus.availableSeats;

            // Open the modal for editing
            document.getElementById("editBusModal").style.display = "block";
        } catch (error) {
            console.error("Error fetching bus details:", error);
            alert("Failed to load bus details.");
        }
    }

    // Close the modal
    function closeEditModal() {
        document.getElementById("editBusModal").style.display = "none";
    }

    // Close when clicking outside the modal
    window.onclick = function (event) {
        let modal = document.getElementById("editBusModal");
        if (event.target == modal) {
            closeEditModal();
        }
    }













    async function submitEditForm() {
        let busId = document.getElementById("editBusId").value;
        let busNumber = document.getElementById("editBusNumber").value;
        let busType = document.getElementById("editBusType").value;
        let totalSeats = document.getElementById("editTotalSeats").value;
        let availableSeats = document.getElementById("editAvailableSeats").value;

        let data = {
            busId: parseInt(busId),
            busNumber: busNumber,
            busType: busType,
            totalSeats: parseInt(totalSeats),
            availableSeats: parseInt(availableSeats)
        };

        let response = await fetch("/Admin/UpdateBus", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(data)
        });

        if (response.ok) {
            closeEditModal();
            location.reload(); // Refresh to show updated data
        } else {
            alert("Failed to update bus details.");
        }

        return false; // Prevent default form submission
    }



</script>
