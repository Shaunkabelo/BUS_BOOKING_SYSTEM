<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Mzansi Bus</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/travel.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header no-print">
    <nav class="shell navigation" aria-label="Main navigation">
        <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">M</span> Mzansi<span>Bus</span></a>
        <div class="nav-links">
            <a asp-controller="Home" asp-action="Index">Find a trip</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Booking" asp-action="History">My bookings</a>
                @if (User.IsInRole("Admin")) { <a asp-controller="Admin" asp-action="Index">Administration</a> }
                <form asp-controller="Account" asp-action="Logout" method="post"><button class="nav-button" type="submit">Sign out</button></form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Sign in</a>
                <a class="button small" asp-controller="Account" asp-action="Register">Create account</a>
            }
        </div>
    </nav>
</header>
<main id="main" class="shell main-content">
    @if (TempData["Message"] is string message) { <div class="notice" role="status">@message</div> }
    @RenderBody()
</main>
<footer class="shell site-footer no-print"><span>Mzansi Bus · A personal booking project</span><span>Demo services · All times SAST (UTC+2)</span></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
